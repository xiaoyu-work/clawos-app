{
  "id": "container-manager",
  "version": "0.1.0",
  "name": {
    "en": "Container Manager"
  },
  "summary": {
    "en": "Inspect and control Docker, rootless/root Podman, and containerd workloads"
  },
  "icon": "📦",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "container-manager.status",
        "summary": {
          "en": "Inspect all container runtimes"
        },
        "needs": [
          {
            "verb": "sys.container",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "observe"
              }
            },
            "why": {
              "en": "Read system and user container inventories."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect all container runtimes"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "container-manager.list",
        "summary": {
          "en": "List containers"
        },
        "args": [
          {
            "name": "runtime",
            "kind": "name",
            "required": true,
            "choices": [
              "docker",
              "podman",
              "podman-root",
              "containerd"
            ]
          },
          {
            "name": "namespace",
            "kind": "name",
            "required": false,
            "required_when": {
              "kind": "arg-equals",
              "arg": "runtime",
              "value": "containerd"
            }
          }
        ],
        "needs": [
          {
            "verb": "sys.container",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "observe"
              }
            },
            "why": {
              "en": "Read container names, images, state, ports, and identifiers."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "List containers"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "container-manager.inspect",
        "summary": {
          "en": "Inspect a container"
        },
        "args": [
          {
            "name": "runtime",
            "kind": "name",
            "required": true,
            "choices": [
              "docker",
              "podman",
              "podman-root",
              "containerd"
            ]
          },
          {
            "name": "target",
            "kind": "name",
            "required": true
          },
          {
            "name": "namespace",
            "kind": "name",
            "required": false,
            "required_when": {
              "kind": "arg-equals",
              "arg": "runtime",
              "value": "containerd"
            }
          }
        ],
        "needs": [
          {
            "verb": "sys.container",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "observe"
              }
            },
            "why": {
              "en": "Read full container configuration and runtime state."
            }
