{
  "id": "hardware-center",
  "version": "0.1.0",
  "name": {
    "en": "Hardware Center"
  },
  "summary": {
    "en": "Inventory CPU, GPU, PCI, USB, memory, storage, drivers, firmware, and thermals"
  },
  "icon": "🖥",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "hardware-center.summary",
        "summary": {
          "en": "Inspect all hardware"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read system-wide hardware and firmware inventory."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect all hardware"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.cpu",
        "summary": {
          "en": "Inspect CPU topology and mitigations"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read CPU topology, features, microcode, and vulnerability state."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect CPU topology and mitigations"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.gpu",
        "summary": {
          "en": "Inspect GPUs and graphics drivers"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read graphics devices, DRM nodes, and bound drivers."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect GPUs and graphics drivers"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.pci",
        "summary": {
          "en": "Inspect PCI devices"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read PCI identifiers, classes, drivers, and IOMMU groups."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect PCI devices"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.usb",
        "summary": {
          "en": "Inspect USB devices"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read USB identifiers, names, serials, authorization, speed, and drivers."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect USB devices"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.memory",
        "summary": {
          "en": "Inspect memory and DIMMs"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read memory totals and SMBIOS memory-device metadata."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect memory and DIMMs"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.storage",
        "summary": {
          "en": "Inspect storage hardware"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read block-device topology, models, serials, transports, filesystems, and mounts."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect storage hardware"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.drivers",
        "summary": {
          "en": "Inspect loaded kernel drivers"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read loaded kernel modules, dependencies, versions, state, and taint."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect loaded kernel drivers"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "hardware-center.thermal",
        "summary": {
          "en": "Inspect temperature and fan sensors"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "hardware"
              }
            },
            "why": {
              "en": "Read kernel thermal zones, hwmon temperatures, limits, and fan speed."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect temperature and fan sensors"
            },
            "recovery": "unknown"
          }
        ]
      }
    ]
  }
}
