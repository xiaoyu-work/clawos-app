{
  "id": "netdiag",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Network Doctor"
  },
  "summary": {
    "en": "Diagnose host interfaces, routes, DNS, TCP reachability, and latency"
  },
  "icon": "🩺",
  "runtime": "python",
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "netdiag.interfaces",
        "summary": {
          "en": "Inspect host network interfaces"
        },
        "args": [],
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "network"
              }
            },
            "why": {
              "en": "Read host interface state and counters."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect host network interfaces"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "netdiag.routes",
        "summary": {
          "en": "Inspect host network routes"
        },
        "args": [],
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "network"
              }
            },
            "why": {
              "en": "Read the host kernel route table."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect host network routes"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "netdiag.dns",
        "summary": {
          "en": "Resolve one exact network target through the host resolver"
        },
        "args": [
          {
            "name": "target",
            "kind": "host",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "net.resolve",
            "scope": {
              "kind": "from-arg",
              "arg": "target"
            },
            "why": {
              "en": "Resolve this exact host or host:port target."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Resolve one exact network target through the host resolver"
            },
            "recovery": "unknown",
            "target_arg": "target"
          }
        ]
      },
      {
        "name": "netdiag.tcp",
        "summary": {
          "en": "Test TCP reachability and latency for one exact host:port target"
        },
        "args": [
          {
            "name": "target",
            "kind": "host",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "attempts",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 3
          },
          {
            "name": "timeout",
            "kind": "number",
            "required": false,
            "binding": "flag",
            "default": 5
          }
        ],
        "needs": [
          {
            "verb": "net.resolve",
            "scope": {
              "kind": "from-arg",
              "arg": "target"
            },
            "why": {
              "en": "Resolve this exact host:port target once."
            }
          },
          {
            "verb": "net.probe",
            "scope": {
              "kind": "from-arg",
              "arg": "target"
            },
            "why": {
              "en": "Open bounded TCP probes only to the resolved target."
            }
          }
        ],
        "effects": [
          {
            "kind": "external",
            "label": {
              "en": "Test TCP reachability and latency for one exact host:port target"
            },
            "recovery": "unknown",
            "target_arg": "target"
          }
        ]
      },
      {
        "name": "netdiag.diagnose",
        "summary": {
          "en": "Run staged host link, route, DNS, and TCP diagnosis"
        },
        "args": [
          {
            "name": "target",
            "kind": "host",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "network"
              }
            },
            "why": {
              "en": "Inspect host interfaces and routes."
            }
          },
          {
            "verb": "net.resolve",
            "scope": {
              "kind": "from-arg",
              "arg": "target"
            },
            "why": {
              "en": "Resolve this exact host:port target once."
            }
          },
          {
            "verb": "net.probe",
            "scope": {
              "kind": "from-arg",
              "arg": "target"
            },
            "why": {
              "en": "Test TCP reachability only to the resolved target."
            }
          }
        ],
        "effects": [
          {
            "kind": "external",
            "label": {
              "en": "Run staged host link, route, DNS, and TCP diagnosis"
            },
            "recovery": "unknown",
            "target_arg": "target"
          }
        ]
      }
    ]
  }
}
