{
  "id": "email",
  "version": "0.1.0",
  "name": {
    "en": "Email"
  },
  "summary": {
    "en": "Email — send, search, and manage email via SMTP or Gmail/Outlook providers"
  },
  "icon": "✉️",
  "runtime": "python",
  "objects": {
    "gmail-draft": {
      "label": {"en": "Gmail draft"},
      "summary": {"en": "A saved Gmail draft; its ID is distinct from the draft message ID."},
      "resolve": {"operation": "gmail_draft", "id_arg": "id"}
    },
    "outlook-draft": {
      "label": {"en": "Outlook draft"},
      "summary": {"en": "A saved Outlook draft; resolution rejects sent messages."},
      "resolve": {"operation": "outlook_draft", "id_arg": "id"}
    },
    "attachment-file": {
      "label": {"en": "Downloaded Mail attachment"},
      "summary": {"en": "Metadata for a downloaded file at an explicitly authorized absolute path; the path does not prove its mail origin."},
      "resolve": {"operation": "attachment_file", "id_arg": "path"}
    },
    "gmail-message": {
      "label": {"en": "Gmail message"},
      "summary": {"en": "A message in the owner's authorized Gmail account, addressed by its opaque provider ID."},
      "resolve": {"operation": "gmail_message", "id_arg": "id"}
    },
    "outlook-message": {
      "label": {"en": "Outlook message"},
      "summary": {"en": "A message in the owner's authorized Outlook account, addressed by its opaque provider ID."},
      "resolve": {"operation": "outlook_message", "id_arg": "id"}
    }
  },
  "ai": {
    "budget": {
      "monthly_units": 100000
    },
    "safety": "standard",
    "origins": [
      "trusted"
    ]
  },
  "operations": {
    "gmail_draft": {
      "label": {"en": "Read a saved Gmail draft and its review fingerprint"},
      "args": [{"name": "id", "kind": "name", "required": true, "binding": "flag"}],
      "needs": [
        {"verb": "secret.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}}, "why": {"en": "Read the owner's Gmail draft credential."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}}, "why": {"en": "Read only the requested Gmail draft."}}
      ]
    },
    "outlook_draft": {
      "label": {"en": "Read a saved Outlook draft and its review fingerprint"},
      "args": [{"name": "id", "kind": "name", "required": true, "binding": "flag"}],
      "needs": [
        {"verb": "secret.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}, "why": {"en": "Read the owner's Outlook draft credential."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "why": {"en": "Read only the requested Outlook draft."}}
      ]
    },
    "draft_save": {
      "label": {"en": "Create or update a provider draft without sending it"},
      "args": [
        {"name": "request-id", "kind": "name", "binding": "flag"},
        {"name": "provider", "kind": "name", "required": true, "binding": "flag", "choices": ["gmail", "outlook"]},
        {"name": "id", "kind": "name", "binding": "flag"},
        {"name": "to", "kind": "text", "required": true, "binding": "flag"},
        {"name": "subject", "kind": "text", "required": true, "binding": "flag"},
        {"name": "body", "kind": "text", "required": true, "binding": "flag"},
        {"name": "cc", "kind": "text", "binding": "flag"}
      ],
      "needs": [
        {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Read this owner's existing Mail submission receipt."}},
        {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Durably bracket this Mail submission without replaying uncertain effects."}},
        {"verb": "secret.read", "scope": {"kind": "from-arg-map", "arg": "provider", "values": {"gmail": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}, "outlook": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}}, "why": {"en": "Use only the selected mailbox's draft credential."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "gmail"}, "why": {"en": "Save or update the Gmail draft; never send it."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "outlook"}, "why": {"en": "Save or update the Outlook draft; never send it."}}
      ]
    },
    "draft_send": {
      "label": {"en": "Explicitly send an unchanged reviewed provider draft"},
      "args": [
        {"name": "request-id", "kind": "name", "binding": "flag"},
        {"name": "provider", "kind": "name", "required": true, "binding": "flag", "choices": ["gmail", "outlook"]},
        {"name": "id", "kind": "name", "required": true, "binding": "flag"},
        {"name": "review", "kind": "name", "required": true, "binding": "flag"},
        {"name": "confirm", "kind": "bool", "required": true, "binding": "flag", "choices": [true]}
      ],
      "needs": [
        {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Read this owner's existing Mail submission receipt."}},
        {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Durably bracket this Mail submission without replaying uncertain effects."}},
        {"verb": "secret.read", "scope": {"kind": "from-arg-map", "arg": "provider", "values": {"gmail": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}, "outlook": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}}, "why": {"en": "Use only the selected mailbox's reviewed draft credential."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "gmail"}, "why": {"en": "Read the current draft and explicitly submit it through Gmail."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "outlook"}, "why": {"en": "Read the current draft and explicitly submit it through Outlook."}}
      ]
    },
    "attachment_file": {
      "label": {"en": "Read metadata for a downloaded Mail attachment file"},
      "args": [{"name": "path", "kind": "path", "required": true, "binding": "flag"}],
      "needs": [
        {"verb": "fs.meta", "scope": {"kind": "from-arg", "arg": "path"}, "why": {"en": "Inspect only the requested attachment file."}}
      ]
    },
    "attachment_download": {
      "label": {"en": "Download one attachment to an explicit new private file"},
      "args": [
        {"name": "provider", "kind": "name", "required": true, "binding": "flag", "choices": ["gmail", "outlook"]},
        {"name": "id", "kind": "name", "required": true, "binding": "flag"},
        {"name": "attachment", "kind": "name", "required": true, "binding": "flag"},
        {"name": "output", "kind": "path", "required": true, "binding": "flag"},
        {"name": "max-bytes", "kind": "integer", "binding": "flag", "default": 16777216}
      ],
      "needs": [
        {"verb": "fs.write", "scope": {"kind": "from-arg", "arg": "output"}, "why": {"en": "Create only the explicitly selected attachment output."}},
        {
          "verb": "secret.read",
          "scope": {"kind": "from-arg-map", "arg": "provider", "values": {
            "gmail": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"},
            "outlook": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}
          }},
          "why": {"en": "Read only the selected mailbox credential."}
        },
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "gmail"}, "why": {"en": "Download the requested Gmail attachment."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "outlook"}, "why": {"en": "Download the requested Outlook attachment."}}
      ]
    },
    "gmail_message": {
      "label": {"en": "Read a Gmail message object by its provider ID"},
      "args": [
        {"name": "id", "kind": "name", "required": true, "binding": "flag"}
      ],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}},
          "why": {"en": "Read only the owner's Gmail credential."}
        },
        {
          "verb": "net.dial",
          "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}},
          "why": {"en": "Read the requested message through the Gmail API."}
        }
      ]
    },
    "outlook_message": {
      "label": {"en": "Read an Outlook message object by its provider ID"},
      "args": [
        {"name": "id", "kind": "name", "required": true, "binding": "flag"}
      ],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}},
          "why": {"en": "Read only the owner's Outlook credential."}
        },
        {
          "verb": "net.dial",
          "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}},
          "why": {"en": "Read the requested message through the Outlook API."}
        }
      ]
    },
    "send": {
      "label": {
        "en": "Send an email (--to, --subject, --body, --provider smtp|gmail|outlook; SMTP requires --host host:port)"
      },
      "args": [
        {"name": "request-id", "kind": "name", "binding": "flag"},
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "smtp",
            "gmail",
            "outlook"
          ]
        },
        {
          "name": "host",
          "kind": "host",
          "label": {
            "en": "SMTP endpoint with an explicit port: mail.example.com:587 (STARTTLS) or mail.example.com:465 (TLS)"
          },
          "required": false,
          "binding": "flag",
          "required_when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "smtp"
          }
        },
        {
          "name": "to",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "subject",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "body",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "cc",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Read this owner's existing Mail submission receipt."}},
        {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Durably bracket this Mail submission without replaying uncertain effects."}},
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "host"
          },
          "why": {
            "en": "Connect only to the explicit SMTP host and port selected for this message."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "smtp"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "gmail.googleapis.com"
            }
          },
          "why": {
            "en": "Open a network connection to the SMTP server or provider API to deliver the message."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "gmail"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "why": {
            "en": "Open a network connection to the SMTP server or provider API to deliver the message."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "smtp": {
                "kind": "name",
                "value": "default/SMTP_PASSWORD"
              },
              "gmail": {
                "kind": "name",
                "value": "default/GOOGLE_ACCESS_TOKEN"
              },
              "outlook": {
                "kind": "name",
                "value": "default/MICROSOFT_ACCESS_TOKEN"
              }
            }
          },
          "why": {
            "en": "Read only the credential for the provider selected before dispatch."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "email"
            }
          },
          "why": {
            "en": "Remember the sent message so the agent can recall it later."
          }
        }
      ]
    },
    "search": {
      "label": {
        "en": "Search emails (--query, --max-results, --provider gmail|outlook)"
      },
      "args": [
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "gmail",
            "outlook"
          ]
        },
        {
          "name": "query",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "max-results",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 10
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "gmail.googleapis.com"
            }
          },
          "why": {
            "en": "Call the provider's API to search your mailbox."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "gmail"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "why": {
            "en": "Call the provider's API to search your mailbox."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "gmail": {
                "kind": "name",
                "value": "default/GOOGLE_ACCESS_TOKEN"
              },
              "outlook": {
                "kind": "name",
                "value": "default/MICROSOFT_ACCESS_TOKEN"
              }
            }
          },
          "why": {
            "en": "Read only the credential for the provider selected before dispatch."
          }
        }
      ]
    },
    "list": {
      "label": {
        "en": "List recent emails (--max-results, --unread, --provider gmail|outlook)"
      },
      "args": [
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "gmail",
            "outlook"
          ]
        },
        {
          "name": "max-results",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 10
        },
        {
          "name": "unread",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "gmail.googleapis.com"
            }
          },
          "why": {
            "en": "Call the provider's API to list recent messages."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "gmail"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "why": {
            "en": "Call the provider's API to list recent messages."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "gmail": {
                "kind": "name",
                "value": "default/GOOGLE_ACCESS_TOKEN"
              },
              "outlook": {
                "kind": "name",
                "value": "default/MICROSOFT_ACCESS_TOKEN"
              }
            }
          },
          "why": {
            "en": "Read only the credential for the provider selected before dispatch."
          }
        }
      ]
    },
    "read": {
      "label": {
        "en": "Read a specific email by ID (--id, --provider gmail|outlook)"
      },
      "args": [
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "gmail",
            "outlook"
          ]
        },
        {
          "name": "id",
          "kind": "text",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "gmail.googleapis.com"
            }
          },
          "why": {
            "en": "Call the provider's API to fetch the message body."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "gmail"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "why": {
            "en": "Call the provider's API to fetch the message body."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "gmail": {
                "kind": "name",
                "value": "default/GOOGLE_ACCESS_TOKEN"
              },
              "outlook": {
                "kind": "name",
                "value": "default/MICROSOFT_ACCESS_TOKEN"
              }
            }
          },
          "why": {
            "en": "Read only the credential for the provider selected before dispatch."
          }
        }
      ]
    },
    "draft": {
      "label": {
        "en": "Draft an email reply via the AI gate (--context, --style formal|casual|short). Does NOT send."
      },
      "needs": [
        {
          "verb": "ai.chat",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Send your context to a model so it can draft an email reply for you."
          }
        }
      ],
      "args": [
        {
          "name": "context",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "style",
          "kind": "text",
          "required": false,
          "binding": "flag",
          "default": "formal",
          "choices": [
            "formal",
            "casual",
            "short"
          ]
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "email.gmail_draft",
        "summary": {"en": "Read a saved Gmail draft and its review fingerprint"},
        "args": [{"name": "id", "kind": "name", "required": true}],
        "needs": [
          {"verb": "secret.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}}, "why": {"en": "Read the owner's Gmail draft credential."}},
          {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}}, "why": {"en": "Read only the requested Gmail draft."}}
        ]
      },
      {
        "name": "email.outlook_draft",
        "summary": {"en": "Read a saved Outlook draft and its review fingerprint"},
        "args": [{"name": "id", "kind": "name", "required": true}],
        "needs": [
          {"verb": "secret.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}, "why": {"en": "Read the owner's Outlook draft credential."}},
          {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "why": {"en": "Read only the requested Outlook draft."}}
        ]
      },
      {
        "name": "email.draft_save",
        "summary": {"en": "Create or update a provider draft without sending it"},
        "args": [
          {"name": "request-id", "kind": "name"},
          {"name": "provider", "kind": "name", "required": true, "choices": ["gmail", "outlook"]},
          {"name": "id", "kind": "name"},
          {"name": "to", "kind": "text", "required": true},
          {"name": "subject", "kind": "text", "required": true},
          {"name": "body", "kind": "text", "required": true},
          {"name": "cc", "kind": "text"}
        ],
        "needs": [
          {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Read this owner's existing Mail submission receipt."}},
          {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "mail-requests"}}, "when": {"kind": "arg-present", "arg": "request-id"}, "why": {"en": "Durably bracket this Mail submission without replaying uncertain effects."}},
          {"verb": "secret.read", "scope": {"kind": "from-arg-map", "arg": "provider", "values": {"gmail": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}, "outlook": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}}, "why": {"en": "Use only the selected mailbox's draft credential."}},
          {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "gmail.googleapis.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "gmail"}, "why": {"en": "Save or update the Gmail draft; never send it."}},
          {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "outlook"}, "why": {"en": "Save or update the Outlook draft; never send it."}}
        ]
      },
      {
        "name": "email.draft_send",
        "summary": {"en": "Explicitly send an unchanged reviewed provider draft"},
