{
  "id": "systemd",
  "version": "0.1.0",
  "name": {
    "en": "System Services"
  },
  "summary": {
    "en": "Inspect and control native systemd units through the privileged Claw OS broker"
  },
  "icon": "🛠",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "systemd.status",
        "summary": {
          "en": "Inspect a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Read the unit's load, active, sub-state, and enablement state."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      },
      {
        "name": "systemd.start",
        "summary": {
          "en": "Start a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.service",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Start this native system service."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Start a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      },
      {
        "name": "systemd.stop",
        "summary": {
          "en": "Stop a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.service",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Stop this native system service."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Stop a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      },
      {
        "name": "systemd.restart",
        "summary": {
          "en": "Restart a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.service",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Restart this native system service."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Restart a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      },
      {
        "name": "systemd.reload",
        "summary": {
          "en": "Reload a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.service",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Ask this service to reload its configuration."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Reload a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      },
      {
        "name": "systemd.enable",
        "summary": {
          "en": "Enable a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.service",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Enable this unit for future boots."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Enable a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      },
      {
        "name": "systemd.disable",
        "summary": {
          "en": "Disable a systemd unit"
        },
        "args": [
          {
            "name": "unit",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "sys.service",
            "scope": {
              "kind": "from-arg",
              "arg": "unit"
            },
            "why": {
              "en": "Disable this unit for future boots."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Disable a systemd unit"
            },
            "recovery": "unknown",
            "target_arg": "unit"
          }
        ]
      }
    ]
  }
}
