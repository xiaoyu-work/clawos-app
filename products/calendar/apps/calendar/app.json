{
  "id": "calendar",
  "version": "0.1.0",
  "name": {
    "en": "Calendar"
  },
  "summary": {
    "en": "Calendar — local events with optional Google/Outlook sync"
  },
  "icon": "📅",
  "runtime": "python",
  "objects": {
    "local-event": {
      "label": {"en": "Local calendar event"},
      "summary": {"en": "An event in the owner's local Calendar data partition."},
      "resolve": {"operation": "local_event", "id_arg": "id"}
    },
    "google-event": {
      "label": {"en": "Google Calendar event"},
      "summary": {"en": "An event in the owner's authorized Google primary calendar."},
      "resolve": {"operation": "google_event", "id_arg": "id"}
    },
    "outlook-event": {
      "label": {"en": "Outlook Calendar event"},
      "summary": {"en": "An event in the owner's authorized Outlook calendar."},
      "resolve": {"operation": "outlook_event", "id_arg": "id"}
    }
  },
  "operations": {
    "invite": {
      "label": {"en": "Create a provider meeting and explicitly request attendee invitations"},
      "args": [
        {"name": "provider", "kind": "name", "required": true, "binding": "flag", "choices": ["google", "outlook"]},
        {"name": "title", "kind": "text", "required": true, "binding": "flag"},
        {"name": "start", "kind": "text", "required": true, "binding": "flag"},
        {"name": "end", "kind": "text", "required": true, "binding": "flag"},
        {"name": "attendees", "kind": "text", "required": true, "binding": "flag"},
        {"name": "description", "kind": "text", "binding": "flag", "default": ""},
        {"name": "location", "kind": "text", "binding": "flag", "default": ""},
        {"name": "confirm", "kind": "bool", "required": true, "binding": "flag", "choices": [true]}
      ],
      "needs": [
        {"verb": "secret.read", "scope": {"kind": "from-arg-map", "arg": "provider", "values": {"google": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}, "outlook": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}}, "why": {"en": "Use only the selected calendar's authorized account."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "www.googleapis.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "google"}, "why": {"en": "Create the Google meeting and request invitations for its supplied attendees."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "outlook"}, "why": {"en": "Create the Outlook meeting and request invitations for its supplied attendees."}}
      ]
    },
    "respond": {
      "label": {"en": "Explicitly respond to a meeting as the authorized calendar owner"},
      "args": [
        {"name": "provider", "kind": "name", "required": true, "binding": "flag", "choices": ["google", "outlook"]},
        {"name": "id", "kind": "name", "required": true, "binding": "flag"},
        {"name": "response", "kind": "name", "required": true, "binding": "flag", "choices": ["accepted", "tentative", "declined"]},
        {"name": "comment", "kind": "text", "binding": "flag", "default": ""},
        {"name": "confirm", "kind": "bool", "required": true, "binding": "flag", "choices": [true]}
      ],
      "needs": [
        {"verb": "secret.read", "scope": {"kind": "from-arg-map", "arg": "provider", "values": {"google": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}, "outlook": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}}}, "why": {"en": "Use only the selected calendar owner's account."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "www.googleapis.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "google"}, "why": {"en": "Update only the owner's attendee response and notify the organizer."}},
        {"verb": "net.dial", "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}}, "when": {"kind": "arg-equals", "arg": "provider", "value": "outlook"}, "why": {"en": "Submit the owner's Outlook meeting response."}}
      ]
    },
    "local_event": {
      "label": {"en": "Read a local Calendar event by its ID"},
      "args": [{"name": "id", "kind": "name", "required": true, "binding": "flag"}],
      "needs": [
        {
          "verb": "data.db.read",
          "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "calendar"}},
          "why": {"en": "Read this event from the owner's existing Calendar database."}
        }
      ]
    },
    "google_event": {
      "label": {"en": "Read a Google Calendar event by its ID"},
      "args": [{"name": "id", "kind": "name", "required": true, "binding": "flag"}],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN"}},
          "why": {"en": "Read only the owner's Google Calendar credential."}
        },
        {
          "verb": "net.dial",
          "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "www.googleapis.com"}},
          "why": {"en": "Read the requested event through the Google Calendar API."}
        }
      ]
    },
    "outlook_event": {
      "label": {"en": "Read an Outlook Calendar event by its ID"},
      "args": [{"name": "id", "kind": "name", "required": true, "binding": "flag"}],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN"}},
          "why": {"en": "Read only the owner's Outlook Calendar credential."}
        },
        {
          "verb": "net.dial",
          "scope": {"kind": "fixed", "scope": {"kind": "host", "value": "graph.microsoft.com"}},
          "why": {"en": "Read the requested event through the Outlook Calendar API."}
        }
      ]
    },
    "list": {
      "label": {
        "en": "List events in a time range (--from, --to, --provider local|google|outlook)"
      },
      "args": [
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "local",
            "google",
            "outlook"
          ]
        },
        {
          "name": "from",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "to",
          "kind": "text",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "data.db.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "calendar"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "local"
          },
          "why": {
            "en": "Read events from the local calendar database."
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "www.googleapis.com"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "google"
          },
          "why": {
            "en": "Call the Google calendar API only when selected."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/GOOGLE_ACCESS_TOKEN"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "google"
          },
          "why": {
            "en": "Read only the Google calendar credential when selected."
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          },
          "why": {
            "en": "Call the Outlook calendar API only when selected."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/MICROSOFT_ACCESS_TOKEN"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          },
          "why": {
            "en": "Read only the Outlook calendar credential when selected."
          }
        }
      ]
    },
