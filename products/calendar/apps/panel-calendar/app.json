{
  "id": "panel-calendar",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Calendar"
  },
  "summary": {
    "en": "Native calendar and local agenda panel applet."
  },
  "icon": "com.clawos.PanelCalendarButton-symbolic",
  "runtime": "binary",
  "entry": "bin/claw-applet-calendar",
  "mcp": {
    "entry": "bin/claw-applet-calendar",
    "transport": "stdio",
    "lifecycle": "lazy",
    "tools": [
      {
        "name": "panel-calendar.day",
        "summary": {
          "en": "Read the owner's local Calendar agenda for one day."
        },
        "args": [
          {
            "name": "date",
            "kind": "text",
            "required": true,
            "binding": "flag",
            "label": {
              "en": "Calendar day (YYYY-MM-DD)"
            }
          }
        ],
        "needs": [
          {
            "verb": "data.db.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "calendar"
              }
            },
            "why": {
              "en": "Read local calendar events for the selected-day agenda."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Read the selected-day Calendar agenda."
            },
            "recovery": "not_applicable"
          }
        ]
      }
    ]
  },
  "operations": {
    "open": {
      "label": {
        "en": "Open the calendar panel applet"
      },
      "needs": [
        {
          "verb": "data.db.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "calendar"
            }
          },
          "why": {
            "en": "Read local calendar events for the selected-day agenda."
          }
        }
      ],
      "effects": [
        {
          "kind": "execute",
          "label": {
            "en": "Open the calendar panel applet"
          },
          "recovery": "unknown"
        }
      ]
    }
  },
  "desktop": {
    "exec": "open",
    "needs": [
      {
        "verb": "data.db.read",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "calendar"}},
        "why": {"en": "Read local calendar events for the selected-day agenda."}
      },
      {
        "verb": "ui.panel",
        "scope": {"kind": "fixed", "scope": {"kind": "wild"}},
        "why": {"en": "Display the calendar panel surface in your authenticated desktop."}
      }
    ],
    "name": {
      "en": "Calendar"
    },
    "icon": "com.clawos.PanelCalendarButton-symbolic",
    "categories": [
      "Utility"
    ],
    "single_instance": true,
    "panel_applet": true
  }
}
