{
  "id": "gateway-telegram",
  "version": "0.2.0",
  "name": {
    "en": "Telegram Gateway"
  },
  "summary": {
    "en": "Telegram outbound client and authenticated owner-bound Activity channel through the OS service."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "chat_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "repeatable": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "api.telegram.org"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/telegram_bot_token"
            }
          },
          "why": {
            "en": "Read the configured telegram_bot_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-telegram"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Send a message through this gateway"
          },
          "recovery": "unknown",
          "target_arg": "chat_id"
        },
        {
          "kind": "update",
          "label": {
            "en": "May record this App's successful result in its own Agent memory scope"
          },
          "recovery": "unknown"
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show status for the OS-managed Telegram channel"
      },
      "args": [],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-telegram"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "read",
          "label": {
            "en": "Show status for the OS-managed Telegram channel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "start": {
      "label": {
        "en": "Start the OS-managed Telegram channel"
      },
      "args": [],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-telegram"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "update",
          "label": {
            "en": "Start the OS-managed Telegram channel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "stop": {
      "label": {
        "en": "Stop the OS-managed Telegram channel"
      },
      "args": [],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-telegram"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "update",
          "label": {
            "en": "Stop the OS-managed Telegram channel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "reply": {
      "label": {
        "en": "Reply once to an authenticated incoming message using its owner-bound receipt"
      },
      "args": [
        {
          "name": "event_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "repeatable": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "choices": [
            true
          ]
        }
      ],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-telegram"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Reply once to an authenticated incoming message using its owner-bound receipt"
          },
          "recovery": "unknown",
          "target_arg": "event_id"
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
