{
  "id": "gateway-discord",
  "version": "0.3.0",
  "name": {
    "en": "Discord Gateway"
  },
  "summary": {
    "en": "Discord outbound client and authenticated owner-bound Activity channel through the OS service."
  },
  "runtime": "python",
  "operations": {
    "configure": {
      "label": {
        "en": "Save legacy local preferences, not owner admission"
      },
      "args": [
        {
          "name": "settings",
          "kind": "text",
          "required": true,
          "repeatable": true
        }
      ],
      "needs": [],
      "effects": [
        {
          "kind": "update",
          "label": {
            "en": "Save legacy local preferences, not owner admission"
          },
          "recovery": "unknown"
        }
      ]
    },
    "send": {
      "label": {
        "en": "Send a message through Discord"
      },
      "args": [
        {
          "name": "channel_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "repeatable": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "discord.com"
            }
          },
          "why": {
            "en": "Call the Discord REST API to post the message."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/discord_bot_token"
            }
          },
          "why": {
            "en": "Load the configured Discord bot token."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-discord"
            }
          },
          "why": {
            "en": "Remember successful outbound Discord messages."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Send a message through Discord"
          },
          "recovery": "unknown",
          "target_arg": "channel_id"
        },
        {
          "kind": "update",
          "label": {
            "en": "May record this App's successful result in its own Agent memory scope"
          },
          "recovery": "unknown"
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show status for the OS-managed Discord channel"
      },
      "args": [],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-discord"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "read",
          "label": {
            "en": "Show status for the OS-managed Discord channel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "start": {
      "label": {
        "en": "Start the OS-managed Discord channel"
      },
      "args": [],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-discord"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "update",
          "label": {
            "en": "Start the OS-managed Discord channel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "stop": {
      "label": {
        "en": "Stop the OS-managed Discord channel"
      },
      "args": [],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-discord"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "update",
          "label": {
            "en": "Stop the OS-managed Discord channel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "reply": {
      "label": {
        "en": "Reply once to an authenticated incoming message using its owner-bound receipt"
      },
      "args": [
        {
          "name": "event_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "repeatable": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "choices": [
            true
          ]
        }
      ],
      "needs": [
        {
          "verb": "ipc.publish",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "channel:gateway-discord"
            }
          },
          "why": {
            "en": "Control only this owner's explicitly configured channel through the authenticated OS service."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Reply once to an authenticated incoming message using its owner-bound receipt"
          },
          "recovery": "unknown",
          "target_arg": "event_id"
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
