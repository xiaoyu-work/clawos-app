{
  "id": "power-manager",
  "version": "0.1.0",
  "name": {
    "en": "Power Manager"
  },
  "summary": {
    "en": "Inspect UPower state and request logind sleep, hibernate, reboot, or shutdown"
  },
  "icon": "⏻",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "power-manager.status",
        "summary": {
          "en": "Inspect batteries and power capabilities"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "power"
              }
            },
            "why": {
              "en": "Read UPower device state and logind power capabilities."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect batteries and power capabilities"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "power-manager.suspend",
        "summary": {
          "en": "Suspend the computer"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "sys.power",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Suspend the whole computer immediately."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Suspend the computer"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "power-manager.hibernate",
        "summary": {
          "en": "Hibernate the computer"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "sys.power",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Write memory to disk and power off the whole computer."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Hibernate the computer"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "power-manager.hybrid-sleep",
        "summary": {
          "en": "Enter hybrid sleep"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "sys.power",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Suspend while preserving a hibernation image."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Enter hybrid sleep"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "power-manager.suspend-then-hibernate",
        "summary": {
          "en": "Suspend then hibernate"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "sys.power",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Suspend now and hibernate later according to logind policy."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Suspend then hibernate"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "power-manager.reboot",
        "summary": {
          "en": "Reboot the computer"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "sys.power",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Restart the whole computer immediately."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Reboot the computer"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "power-manager.poweroff",
        "summary": {
          "en": "Power off the computer"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "sys.power",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Shut down and power off the whole computer immediately."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Power off the computer"
            },
            "recovery": "unknown"
          }
        ]
      }
    ]
  }
}
