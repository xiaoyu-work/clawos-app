{
  "id": "desktop-manager",
  "version": "0.1.0",
  "name": {
    "en": "Desktop Manager"
  },
  "summary": {
    "en": "Discover, focus, close, and restart COSMIC Wayland windows"
  },
  "icon": "🗔",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "desktop-manager.list",
        "summary": {
          "en": "List running desktop windows"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "desktop"
              }
            },
            "why": {
              "en": "Read window titles, AppIDs, stable identifiers, and compositor state."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "List running desktop windows"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "desktop-manager.focus",
        "summary": {
          "en": "Focus a desktop window"
        },
        "args": [
          {
            "name": "identifier",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "desktop.window",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Ask the compositor to activate the selected window."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Focus a desktop window"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "desktop-manager.close",
        "summary": {
          "en": "Close a desktop window"
        },
        "args": [
          {
            "name": "identifier",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "desktop.window",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Ask the compositor to close the selected window."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Close a desktop window"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "desktop-manager.restart",
        "summary": {
          "en": "Restart a desktop application"
        },
        "args": [
          {
            "name": "identifier",
            "kind": "name",
            "required": true
          },
          {
            "name": "app_id",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "desktop.window",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Close every window whose compositor AppID matches the selected window."
            }
          },
          {
            "verb": "desktop.launch",
            "scope": {
              "kind": "from-arg",
              "arg": "app_id"
            },
            "why": {
              "en": "Relaunch the exact desktop AppID after its windows close."
            }
          }
        ],
        "effects": [
          {
            "kind": "execute",
            "label": {
              "en": "Restart a desktop application"
            },
            "recovery": "unknown",
            "target_arg": "app_id"
          }
        ]
      }
    ]
  }
}
