{
  "id": "printer-manager",
  "version": "0.1.0",
  "name": {
    "en": "Printer Manager"
  },
  "summary": {
    "en": "Discover CUPS printers, inspect capabilities/queues, print files, and cancel owned jobs"
  },
  "icon": "🖨",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "printer-manager.status",
        "summary": {
          "en": "List CUPS printers"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "printing"
              }
            },
            "why": {
              "en": "Read configured printer names, state, and default destination."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "List CUPS printers"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "printer-manager.capabilities",
        "summary": {
          "en": "Inspect printer capabilities"
        },
        "args": [
          {
            "name": "printer",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "printing"
              }
            },
            "why": {
              "en": "Read supported media, duplex, quality, and other CUPS options."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect printer capabilities"
            },
            "recovery": "unknown",
            "target_arg": "printer"
          }
        ]
      },
      {
        "name": "printer-manager.jobs",
        "summary": {
          "en": "Inspect queued print jobs"
        },
        "args": [
          {
            "name": "printer",
            "kind": "name",
            "required": false
          }
        ],
        "needs": [
          {
            "verb": "device.printer",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "observe"
              }
            },
            "why": {
              "en": "Read job IDs, owners, sizes, and submission times."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Inspect queued print jobs"
            },
            "recovery": "unknown",
            "target_arg": "printer"
          }
        ]
      },
      {
        "name": "printer-manager.print",
        "summary": {
          "en": "Print a file"
        },
        "args": [
          {
            "name": "printer",
            "kind": "name",
            "required": true
          },
          {
            "name": "source",
            "kind": "path",
            "required": true
          },
          {
            "name": "sides",
            "kind": "name",
            "binding": "flag",
            "required": false,
            "choices": [
              "one-sided",
              "two-sided-long-edge",
              "two-sided-short-edge"
            ]
          },
          {
            "name": "copies",
            "kind": "integer",
            "binding": "flag",
            "required": false,
            "default": 1
          },
          {
            "name": "title",
            "kind": "text",
            "binding": "flag",
            "required": false
          },
          {
            "name": "media",
            "kind": "name",
            "binding": "flag",
            "required": false
          }
        ],
        "needs": [
          {
            "verb": "device.printer",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "print"
              }
            },
            "why": {
              "en": "Submit one bounded document to a selected printer."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "from-arg",
              "arg": "source"
            },
            "why": {
              "en": "Read the exact source file through a pinned file descriptor."
            }
          }
        ],
        "effects": [
          {
            "kind": "external",
            "label": {
              "en": "Print a file"
            },
            "recovery": "unknown",
            "target_arg": "source"
          }
        ]
      },
      {
        "name": "printer-manager.cancel",
        "summary": {
          "en": "Cancel an owned print job"
        },
        "args": [
          {
            "name": "job_id",
            "kind": "name",
            "required": true
          },
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "binding": "flag",
            "choices": [
              true
            ]
          }
        ],
        "needs": [
          {
            "verb": "device.printer",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Cancel the exact queued job after verifying its owner."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Cancel an owned print job"
            },
            "recovery": "unknown"
          }
        ]
      }
    ]
  }
}
