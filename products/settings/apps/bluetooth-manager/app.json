{
  "id": "bluetooth-manager",
  "version": "0.1.0",
  "name": {
    "en": "Bluetooth Manager"
  },
  "summary": {
    "en": "Discover, pair, connect, trust, forget, and power BlueZ devices"
  },
  "icon": "ᛒ",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "bluetooth-manager.status",
        "summary": {
          "en": "List Bluetooth adapters and devices"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "bluetooth"
              }
            },
            "why": {
              "en": "Read BlueZ adapter and device state."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "List Bluetooth adapters and devices"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "bluetooth-manager.power",
        "summary": {
          "en": "Power a Bluetooth adapter on or off"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "state",
            "kind": "name",
            "required": true,
            "choices": [
              "on",
              "off"
            ]
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Change global Bluetooth adapter power state."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Power a Bluetooth adapter on or off"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "bluetooth-manager.scan",
        "summary": {
          "en": "Scan for nearby Bluetooth devices"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "seconds",
            "kind": "integer",
            "required": false,
            "default": 10
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Temporarily enable discovery on a Bluetooth adapter."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Scan for nearby Bluetooth devices"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "bluetooth-manager.pair",
        "summary": {
          "en": "Pair a Bluetooth device"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "device",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Start BlueZ pairing; the desktop agent may request confirmation or a passkey."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Pair a Bluetooth device"
            },
            "recovery": "unknown",
            "target_arg": "device"
          }
        ]
      },
      {
        "name": "bluetooth-manager.pair-status",
        "summary": {
          "en": "Check a Bluetooth pairing session"
        },
        "args": [
          {
            "name": "pairing_id",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Read the state and pending prompt of an active pairing session."
            }
          }
        ],
        "effects": [
          {
            "kind": "read",
            "label": {
              "en": "Check a Bluetooth pairing session"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "bluetooth-manager.pair-respond",
        "summary": {
          "en": "Respond to a Bluetooth pairing prompt"
        },
        "args": [
          {
            "name": "pairing_id",
            "kind": "name",
            "required": true
          },
          {
            "name": "response",
            "kind": "text",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Confirm, reject, or provide the PIN/passkey requested by BlueZ."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Respond to a Bluetooth pairing prompt"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "bluetooth-manager.pair-cancel",
        "summary": {
          "en": "Cancel a Bluetooth pairing session"
        },
        "args": [
          {
            "name": "pairing_id",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Cancel the selected active BlueZ pairing transaction."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Cancel a Bluetooth pairing session"
            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "bluetooth-manager.connect",
        "summary": {
          "en": "Connect a Bluetooth device"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "device",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Connect the selected Bluetooth device."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Connect a Bluetooth device"
            },
            "recovery": "unknown",
            "target_arg": "device"
          }
        ]
      },
      {
        "name": "bluetooth-manager.disconnect",
        "summary": {
          "en": "Disconnect a Bluetooth device"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "device",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Disconnect the selected Bluetooth device."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Disconnect a Bluetooth device"
            },
            "recovery": "unknown",
            "target_arg": "device"
          }
        ]
      },
      {
        "name": "bluetooth-manager.trust",
        "summary": {
          "en": "Trust a Bluetooth device"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "device",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Allow future automatic connections from this device."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Trust a Bluetooth device"
            },
            "recovery": "unknown",
            "target_arg": "device"
          }
        ]
      },
      {
        "name": "bluetooth-manager.untrust",
        "summary": {
          "en": "Remove trust from a Bluetooth device"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "device",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Disable trusted automatic connections for this device."
            }
          }
        ],
        "effects": [
          {
            "kind": "update",
            "label": {
              "en": "Remove trust from a Bluetooth device"
            },
            "recovery": "unknown",
            "target_arg": "device"
          }
        ]
      },
      {
        "name": "bluetooth-manager.forget",
        "summary": {
          "en": "Forget a Bluetooth device"
        },
        "args": [
          {
            "name": "adapter",
            "kind": "name",
            "required": true
          },
          {
            "name": "device",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "device.bluetooth",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Remove pairing and saved state for this device."
            }
          }
        ],
        "effects": [
          {
            "kind": "delete",
            "label": {
              "en": "Forget a Bluetooth device"
            },
            "recovery": "unknown",
            "target_arg": "device"
          }
        ]
      }
    ]
  }
}
