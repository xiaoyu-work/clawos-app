            },
            "recovery": "unknown"
          }
        ]
      },
      {
        "name": "player.status",
        "summary": {
          "en": "Read live Media Player playback status and current track metadata."
        },
        "args": [],
        "needs": [
          {
            "verb": "desktop.media.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "cosmic-player"
              }
            },
            "why": {
              "en": "Read playback status and track metadata from this owner's native Media Player."
            }
          }
        ],
        "effects": [
          {
