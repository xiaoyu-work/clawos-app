{
  "id": "desktop-shell",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {"en": "Claw Desktop"},
  "summary": {"en": "The Claw OS desktop shell, built from Quickshell and Caelestia."},
  "runtime": "binary",
  "entry": "bin/claw-desktop-shell",
  "desktop": {
    "exec": "--gui",
    "needs": [
      {
        "verb": "ui.panel",
        "scope": {"kind": "fixed", "scope": {"kind": "wild"}},
        "why": {"en": "Display the desktop panel, launcher, overview and desktop drawers."}
      },
      {
        "verb": "sys.observe",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "desktop"}},
        "why": {"en": "Show your authenticated desktop windows and workspace state."}
      },
      {
        "verb": "desktop.window",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "control"}},
        "why": {"en": "Apply your window focus, close and workspace actions."}
      },
      {
        "verb": "desktop.launch",
        "scope": {"kind": "fixed", "scope": {"kind": "wild"}},
        "why": {"en": "Launch the exact installed application you select in the desktop launcher."}
      },
      {
        "verb": "ipc.subscribe",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "notifications.presentation"}},
        "why": {"en": "Present notifications from the OS Notification Service."}
      },
      {
        "verb": "ipc.invoke",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "notifications.presentation"}},
        "why": {"en": "Apply your notification dismissal and acknowledgement actions."}
      }
    ],
    "optional_needs": [
      {
        "verb": "sys.observe",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "audio"}},
        "why": {"en": "Show owner audio devices, streams and volume in the desktop controls."}
      },
      {
        "verb": "device.audio",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "output"}},
        "why": {"en": "Change the output volume and mute when you use the desktop controls."}
      },
      {
        "verb": "device.microphone",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "input"}},
        "why": {"en": "Change microphone volume and mute through the OS audio service."}
      },
      {
        "verb": "device.media-route",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "pipewire"}},
        "why": {"en": "Choose a different default audio input or output device."}
      },
      {
        "verb": "sys.observe",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "display"}},
        "why": {"en": "Read the display brightness shown in the desktop controls."}
      },
      {
        "verb": "device.display",
        "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "manage"}},
        "why": {"en": "Change display brightness through the OS display service."}
      }
    ]
  }
}
