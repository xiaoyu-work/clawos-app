{
  "id": "web",
  "version": "0.2.0",
  "name": {
    "en": "Browser"
  },
  "summary": {
    "en": "Browser via cos-browser (vendored Obscura) — text/links/JSON output, JS rendering, optional CDP"
  },
  "icon": "🧭",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 200000
    },
    "safety": "strict",
    "origins": [
      "external-content"
    ]
  },
  "operations": {
    "read": {
      "label": {
        "en": "Fetch URL, return {url, title, text, links} (or raw HTML / arbitrary --eval result)"
      },
      "args": [
        {
          "name": "url",
          "kind": "text",
          "required": true
        },
        {
          "name": "selector",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "wait",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "timeout",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 30
        },
        {
          "name": "max-length",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 50000
        },
        {
          "name": "html",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        },
        {
          "name": "eval",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "user-agent",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "url",
            "transform": "url-host"
          },
          "why": {
            "en": "Open a network connection to the URL you asked to load."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Fetch URL, return {url, title, text, links} (or raw HTML / arbitrary --eval result)"
          },
          "recovery": "unknown"
        }
      ]
    },
    "scrape": {
      "label": {
        "en": "Fetch many URLs in parallel"
      },
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "urls",
            "transform": "url-host"
          },
          "why": {
            "en": "Open network connections to each URL you asked to load."
          }
        }
      ],
      "args": [
        {
          "name": "urls",
          "kind": "text",
          "required": true,
          "repeatable": true
        },
        {
          "name": "eval",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "concurrency",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 10
        },
        {
          "name": "timeout",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 60
        },
        {
          "name": "format",
          "kind": "name",
          "required": false,
          "binding": "flag",
          "default": "json"
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Fetch many URLs in parallel"
          },
          "recovery": "unknown"
        }
      ]
    },
    "screenshot": {
      "label": {
        "en": "Capture a screenshot of a URL (shells out to chromium)"
      },
      "args": [
        {
          "name": "url",
          "kind": "text",
          "required": true
        },
        {
          "name": "output",
          "kind": "path",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "width",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 1280
        },
        {
          "name": "height",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 720
        },
        {
          "name": "full-page",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        },
        {
          "name": "timeout",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 60
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "url",
            "transform": "url-host"
          },
          "why": {
            "en": "Open a network connection to the URL you asked to capture."
          }
        },
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "output"
          },
          "why": {
            "en": "Save the screenshot to the path you specified."
          }
        }
      ],
      "effects": [
        {
          "kind": "create",
          "label": {
            "en": "Capture a screenshot of a URL (shells out to chromium)"
          },
          "recovery": "unknown",
          "target_arg": "output"
        },
        {
          "kind": "external",
          "label": {
            "en": "May contact the explicitly selected remote provider"
          },
          "recovery": "unknown"
        }
      ]
    },
    "submit": {
      "label": {
        "en": "Submit form data (POST) via urllib"
      },
      "args": [
        {
          "name": "url",
          "kind": "text",
          "required": true
        },
        {
          "name": "data",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "method",
          "kind": "name",
          "required": false,
          "binding": "flag",
          "default": "POST"
        },
        {
          "name": "timeout",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 30
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "url",
            "transform": "url-host"
          },
          "why": {
            "en": "POST to the URL you asked to submit data to."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Submit form data (POST) via urllib"
          },
          "recovery": "unknown"
        }
      ]
    },
    "summarize": {
      "label": {
        "en": "Fetch a URL and return a 3-line AI summary"
      },
      "args": [
        {
          "name": "url",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "url",
            "transform": "url-host"
          },
          "why": {
            "en": "Open a network connection to the URL so its text can be fetched."
          }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Send the fetched page text to a model so it can be summarised for you."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "web"
            }
          },
          "why": {
            "en": "Remember the page summary so the agent can recall it later."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Fetch a URL and return a 3-line AI summary"
          },
          "recovery": "unknown"
        },
        {
          "kind": "external",
          "label": {
            "en": "Request SDK AI processing under existing consent and budget"
          },
          "recovery": "unknown"
        },
        {
          "kind": "update",
          "label": {
            "en": "May record this App's successful result in its own Agent memory scope"
          },
          "recovery": "unknown"
        }
      ]
    }
  },
  "dependencies": {
    "binaries": [
      "cos-browser"
    ],
    "optional_binaries": [
      "chromium",
      "chromium-browser",
      "google-chrome-stable",
      "google-chrome"
    ]
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
