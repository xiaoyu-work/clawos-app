{
  "id": "kv",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Key-Value Store"
  },
  "summary": {
    "en": "Persistent string key-value storage"
  },
  "icon": "🔑",
  "runtime": "python",
  "objects": {
    "entry": {
      "label": {"en": "Key-value entry"},
      "summary": {"en": "An App-owned entry addressed by its exact key. Resolution retains get's empty-string result for a missing key; metadata is not proof of existence."},
      "resolve": {"operation": "get", "id_arg": "key"}
    }
  },
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "tools": [
      {
        "name": "kv.get",
        "effects": [
          {"kind": "read", "label": {"en": "Read the value of the requested key"}, "target_arg": "key", "recovery": "not_applicable"}
        ],
        "summary": {
          "en": "Read the value stored under `key`. Returns an empty string if missing."
        },
        "args": [
          {
            "name": "key",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "data.kv.read",
            "scope": {
              "kind": "from-arg",
              "arg": "key"
            },
            "why": {
              "en": "Read the value stored under the named key."
            }
          }
        ]
      },
      {
        "name": "kv.set",
        "effects": [
          {"kind": "update", "label": {"en": "Store the value under the requested key"}, "target_arg": "key", "recovery": "unknown"}
        ],
        "summary": {
          "en": "Store `value` under `key`, overwriting any prior value."
        },
        "args": [
          {
            "name": "key",
            "kind": "name",
            "required": true
          },
          {
            "name": "value",
            "kind": "text",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "data.kv.write",
            "scope": {
              "kind": "from-arg",
              "arg": "key"
            },
            "why": {
              "en": "Store the value you provided under the named key."
            }
          }
        ]
      },
      {
        "name": "kv.del",
        "effects": [
          {"kind": "delete", "label": {"en": "Delete the requested key"}, "target_arg": "key", "recovery": "unknown"}
        ],
        "summary": {
          "en": "Delete `key`. Idempotent; missing keys still succeed."
        },
        "args": [
          {
            "name": "key",
            "kind": "name",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "data.kv.delete",
            "scope": {
              "kind": "from-arg",
              "arg": "key"
            },
            "why": {
              "en": "Remove the named key from the store."
            }
          }
        ]
      },
      {
        "name": "kv.list",
        "summary": {
          "en": "List keys matching the glob `pattern`. Returns a sorted name list."
        },
        "args": [
          {
            "name": "pattern",
            "kind": "text",
            "required": false,
            "default": "*"
          }
        ],
        "needs": [
          {
            "verb": "data.kv.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "wild"
              }
            },
            "why": {
              "en": "Scan every key in the store to filter by the pattern."
            }
          }
        ]
      },
      {
        "name": "kv.dump",
        "summary": {
          "en": "Return every key/value pair in the store."
        },
        "needs": [
          {
            "verb": "data.kv.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "wild"
              }
            },
            "why": {
              "en": "Read every key and value in the store."
            }
          }
        ]
      }
    ]
  }
}
