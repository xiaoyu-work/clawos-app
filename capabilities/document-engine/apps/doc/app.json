{
  "id": "doc",
  "version": "0.1.0",
  "name": {
    "en": "Documents"
  },
  "summary": {
    "en": "Universal document reader — any format in, structured text out"
  },
  "icon": "📄",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 200000
    },
    "safety": "strict",
    "origins": [
      "external-content"
    ]
  },
  "operations": {
    "read": {
      "label": {
        "en": "Read document content (PDF, DOCX, XLSX, PPTX, CSV, etc.)"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Read the contents of the file you asked to open."
          }
        }
      ],
      "effects": [
        {
          "kind": "read",
          "label": {
            "en": "Read document content (PDF, DOCX, XLSX, PPTX, CSV, etc.)"
          },
          "recovery": "unknown",
          "target_arg": "path"
        }
      ]
    },
    "info": {
      "label": {
        "en": "Get document metadata without reading full content"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.meta",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Inspect the file's metadata (size, format) without reading its content."
          }
        }
      ],
      "effects": [
        {
          "kind": "read",
          "label": {
            "en": "Get document metadata without reading full content"
          },
          "recovery": "unknown",
          "target_arg": "path"
        }
      ]
    },
    "convert": {
      "label": {
        "en": "Convert document to another format"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        },
        {
          "name": "to",
          "kind": "name",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Read the source document so it can be converted."
          }
        },
        {
          "verb": "fs.write",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Write the converted document to disk."
          }
        }
      ],
      "effects": [
        {
          "kind": "create",
          "label": {
            "en": "Convert document to another format"
          },
          "recovery": "unknown"
        }
      ]
    },
    "summarize": {
      "label": {
        "en": "Summarize a document into 5 short bullet lines via the AI gate"
      },
      "stdin": true,
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": false,
          "repeatable": true
        },
        {
          "name": "file",
          "kind": "path",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "file"
          },
          "why": {
            "en": "Read the document so its contents can be summarised."
          },
          "when": {
            "kind": "arg-present",
            "arg": "file"
          }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Send the document text to a model so it can be summarised for you."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "doc"
            }
          },
          "why": {
            "en": "Remember the document summary so the agent can recall it later."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Summarize a document into 5 short bullet lines via the AI gate"
          },
          "recovery": "unknown"
        },
        {
          "kind": "update",
          "label": {
            "en": "May record this App's successful result in its own Agent memory scope"
          },
          "recovery": "unknown"
        }
      ]
    },
    "explain": {
      "label": {
        "en": "Explain the supplied content in plain prose via the AI gate"
      },
      "stdin": true,
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": false,
          "repeatable": true
        },
        {
          "name": "file",
          "kind": "path",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "file"
          },
          "why": {
            "en": "Read the document so it can be explained."
          },
          "when": {
            "kind": "arg-present",
            "arg": "file"
          }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Send the content to a model so it can be explained for you."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Explain the supplied content in plain prose via the AI gate"
          },
          "recovery": "unknown"
        }
      ]
    },
    "rewrite": {
      "label": {
        "en": "Rewrite the supplied content following an instruction"
      },
      "stdin": true,
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": false,
          "repeatable": true
        },
        {
          "name": "file",
          "kind": "path",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "instruction",
          "kind": "name",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "file"
          },
          "why": {
            "en": "Read the document so it can be rewritten."
          },
          "when": {
            "kind": "arg-present",
            "arg": "file"
          }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Send the content to a model to be rewritten per your instruction."
          }
        }
      ],
      "effects": [
        {
          "kind": "external",
          "label": {
            "en": "Rewrite the supplied content following an instruction"
          },
          "recovery": "unknown"
        }
      ]
    }
  },
  "dependencies": {
    "python": [
      "pymupdf",
      "python-docx",
      "openpyxl",
      "python-pptx"
    ]
  },
  "schema_version": 2,
